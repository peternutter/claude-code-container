#!/bin/zsh
# claude-sandbox - Run Claude Code in a Docker container
# Location: ~/.claude/bin/claude-sandbox (installed by install.sh)
#
# Usage: claude-sandbox [project_path]
#
# Examples:
#   claude-sandbox .              # Current directory
#   claude-sandbox ~/myproject    # Specific project

set -e

project_path="$(pwd)"

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            cat <<'HELP'
claude-sandbox - Run Claude Code unhinged in a Docker container

USAGE
    claude-sandbox [PROJECT_PATH]

OPTIONS
    -h, --help  Show this help message

EXAMPLES
    claude-sandbox                     # Current directory
    claude-sandbox ~/projects/myapp    # Specific project

WHAT IT DOES
    Runs Claude Code with --dangerously-skip-permissions inside a container.
    Claude can build, test, and iterate autonomously without approval prompts.
    Only the project directory and ~/.claude are accessible to the container.

    Includes: Python 3.12, uv, ruff, mypy, pytest, gh, ssh, Node.js 22

MOUNTS
    claude-home volume     -> /home/claude            (persistent home)
    ~/.claude              -> /home/claude/.claude    (auth, settings from host)
    ~/Screenshots          -> /home/claude/Screenshots (read-only)
    <project_path>         -> /home/claude/workspace

ENVIRONMENT
    Place a .env file in your project root to pass environment variables
    (e.g., GH_TOKEN for GitHub CLI authentication).

    CLAUDE_SANDBOX_SKIP_NETWORK    Skip the Docker network selection prompt

MORE INFO
    https://github.com/todd-working/claude-code-container
HELP
            exit 0
            ;;
        *)
            if [[ -d "$1" ]]; then
                project_path="$1"
            else
                echo "Unknown argument: $1"
                echo "Usage: claude-sandbox [project_path]"
                exit 1
            fi
            shift
            ;;
    esac
done

# Resolve to absolute path (handles "." -> "/full/path/to/dir")
project_path="$(cd "$project_path" && pwd)"
project_name="$(basename "$project_path")"

image="claude-sandbox"
docker_args=()

# Persist uv cache and installed Python tools across sessions
docker_args+=(-v claude-uv-cache:/home/claude/.cache/uv -v claude-python-bin:/home/claude/.local/bin)

# ============================================================
# CROSS-LINK SESSION HISTORY
# ============================================================
# Claude Code keys history on the absolute workspace path. Inside the container
# that's always /home/claude/workspace, but on the host it's the real project path.
# Cross-link sessions so both sides see each other's conversations via /resume.

host_project_key="${project_path//\//-}"
container_project_key="-home-claude-workspace"
host_project_dir="$HOME/.claude/projects/$host_project_key"
container_project_dir="$HOME/.claude/projects/$container_project_key"

if [[ -d "$host_project_dir" && "$host_project_key" != "$container_project_key" ]]; then
    mkdir -p "$container_project_dir" "$host_project_dir"

    # Hard-link host sessions into container project dir
    # (hard links, not symlinks — Claude Code ignores symlinks when listing sessions)
    for f in "$host_project_dir"/*.jsonl(N); do
        [[ -L "$f" ]] && continue
        base="$(basename "$f")"
        [[ ! -e "$container_project_dir/$base" ]] && \
            ln "$f" "$container_project_dir/$base"
    done

    # Hard-link container sessions into host project dir
    for f in "$container_project_dir"/*.jsonl(N); do
        [[ -L "$f" ]] && continue
        base="$(basename "$f")"
        [[ ! -e "$host_project_dir/$base" ]] && \
            ln "$f" "$host_project_dir/$base"
    done

    # Also cross-link companion directories (subagent data)
    # Directories can't be hard-linked, so copy them as symlinks (best effort)
    for d in "$host_project_dir"/*(N/); do
        [[ -L "$d" ]] && continue
        base="$(basename "$d")"
        [[ ! -e "$container_project_dir/$base" ]] && \
            ln -s "../$host_project_key/$base" "$container_project_dir/$base"
    done
    for d in "$container_project_dir"/*(N/); do
        [[ -L "$d" ]] && continue
        base="$(basename "$d")"
        [[ ! -e "$host_project_dir/$base" ]] && \
            ln -s "../$container_project_key/$base" "$host_project_dir/$base"
    done

    echo "History: cross-linked with $(basename "$host_project_dir")"
fi

# ============================================================
# PRE-FLIGHT CHECKS
# ============================================================

echo "Pre-flight checks..."

# Check ~/.claude exists
if [[ ! -d "$HOME/.claude" ]]; then
    echo "✗ ~/.claude not found."
    echo ""
    echo "  Run Claude Code outside the container first:"
    echo "    npx @anthropic-ai/claude-code"
    exit 1
fi

# Check image exists
if ! docker image inspect "$image" &>/dev/null; then
    echo "✗ Docker image '$image' not found."
    echo ""
    echo "  Build it first (from claude-code-container repo):"
    echo "    make build"
    exit 1
fi

# Show mount info
echo ""
echo "Mounts:"
echo "  ~/.claude → /home/claude/.claude"
echo "  ~/Screenshots → /home/claude/Screenshots (ro)"
echo "  $project_path → /home/claude/workspace"
echo ""
echo "Copied into volume (not bind-mounted):"
[[ -f "$HOME/.claude.json" ]] && echo "  ✓ ~/.claude.json"
[[ -d "$HOME/.google_workspace_mcp" ]] && echo "  ✓ ~/.google_workspace_mcp/"

# Check CLAUDE.md files
[[ -f "$HOME/.claude/CLAUDE.md" ]] && echo "  ✓ Global CLAUDE.md" || echo "  ○ No global CLAUDE.md"
if [[ -f "$project_path/CLAUDE.md" ]]; then
    echo "  ✓ Project CLAUDE.md (root)"
elif [[ -f "$project_path/.claude/CLAUDE.md" ]]; then
    echo "  ✓ Project CLAUDE.md (.claude/)"
else
    echo "  ○ No project CLAUDE.md"
fi
echo ""

# ============================================================
# NETWORK SELECTION (optional)
# ============================================================

if [[ -z "${CLAUDE_SANDBOX_SKIP_NETWORK:-}" ]]; then
    # Get custom networks (zsh array syntax)
    networks=("${(@f)$(docker network ls --format "{{.Name}}" | grep -vE "^(bridge|host|none)$" || true)}")
    if [[ ${#networks[@]} -gt 0 && -n "${networks[1]}" ]]; then
        echo "Available Docker networks:"
        echo "  0) None (default)"
        local i=1
        for net in "${networks[@]}"; do
            [[ -n "$net" ]] && echo "  $i) $net" && ((i++))
        done
        echo -n "Join a network? [0-$((i-1))]: "
        read -r choice
        if [[ "$choice" =~ ^[1-9][0-9]*$ ]] && [[ $choice -lt $i ]]; then
            local selected_network="${networks[$choice]}"
            docker_args+=(--network "$selected_network")
            echo "Joining network: $selected_network"
        fi
    fi
fi

# ============================================================
# RUN CONTAINER
# ============================================================

# Sync MCP servers and OAuth credentials into the claude-home volume.
# Uses `claude mcp add-json` so Claude Code manages its own config file.
echo "Syncing configs into container volume..."

# Extract mcpServers from host config
if [[ -f "$HOME/.claude.json" ]]; then
    mcp_servers=$(python3 -c "
import json, sys
with open('$HOME/.claude.json') as f:
    data = json.load(f)
for name, config in data.get('mcpServers', {}).items():
    print(name)
    print(json.dumps(config))
" 2>/dev/null)
fi

# Build the sync script to run inside the container
sync_script='#!/bin/sh
'

# Add each MCP server via claude mcp add-json
if [[ -n "$mcp_servers" ]]; then
    while IFS= read -r name && IFS= read -r config; do
        # Escape single quotes in config for shell embedding
        escaped_config="${config//\'/\'\\\'\'}"
        sync_script+="claude mcp add-json '$name' '$escaped_config' --scope user 2>/dev/null
"
    done <<< "$mcp_servers"
fi

# Copy Google Workspace OAuth credentials
sync_script+='
if [ -d /tmp/host-google-workspace-mcp ]; then
    mkdir -p /home/claude/.google_workspace_mcp
    cp -r /tmp/host-google-workspace-mcp/* /home/claude/.google_workspace_mcp/
fi
'

# Run sync inside the container image (has claude CLI)
sync_args=()
[[ -d "$HOME/.google_workspace_mcp" ]] && sync_args+=(-v "$HOME/.google_workspace_mcp":/tmp/host-google-workspace-mcp:ro)

docker run --rm \
    --user "$(id -u):$(id -g)" \
    --entrypoint sh \
    -e HOME=/home/claude \
    -v claude-home:/home/claude \
    "${sync_args[@]}" \
    "$image" -c "$sync_script"

# Pass .env file if it exists in the project root (for GH_TOKEN, etc.)
if [[ -f "$project_path/.env" ]]; then
    docker_args+=(--env-file "$project_path/.env")
    echo "Environment: loaded .env"
fi

# Volume mount order matters:
# 1. claude-home volume provides persistent home directory (for .claude.json, etc.)
# 2. ~/.claude bind mount overlays credentials/settings from host
# 3. workspace bind mount overlays the project directory

docker run -it --rm \
    --user "$(id -u):$(id -g)" \
    --name "claude-$project_name" \
    -e HOME=/home/claude \
    -e TERM=xterm-256color \
    "${docker_args[@]}" \
    -v claude-home:/home/claude \
    -v "$HOME/.claude":/home/claude/.claude \
    -v "$HOME/Screenshots":/home/claude/Screenshots:ro \
    -v "$project_path":/home/claude/workspace \
    "$image"
