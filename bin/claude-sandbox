#!/bin/zsh
# claude-sandbox - Run Claude Code in a Docker container
# Location: ~/.claude/bin/claude-sandbox (installed by install.sh)
#
# Usage: claude-sandbox [OPTIONS] [PROJECT_PATH] [CLAUDE_ARGS...]
#
# Examples:
#   claude-sandbox .                    # Current directory
#   claude-sandbox ~/myproject          # Specific project
#   claude-sandbox . --resume           # Resume last conversation
#   claude-sandbox --as /path/to/ws .   # Custom container workspace path

set -e

project_path="$(pwd)"
claude_args=()
as_path=""
project_path_set=false

# Parse arguments: sandbox flags first, then project path, then claude args
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            cat <<'HELP'
claude-sandbox - Run Claude Code unhinged in a Docker container

USAGE
    claude-sandbox [OPTIONS] [PROJECT_PATH] [-- CLAUDE_ARGS...]
    claude-sandbox [PROJECT_PATH] [CLAUDE_ARGS...]

OPTIONS
    -h, --help       Show this help message
    --as <path>      Override the container workspace path (must be absolute).
                     Useful for resuming sessions created under a different path.

CLAUDE ARGS
    All unrecognized flags and non-directory arguments are forwarded to the
    claude CLI inside the container. Use -- to be explicit about separation.

EXAMPLES
    claude-sandbox                                  # Current directory
    claude-sandbox ~/projects/myapp                 # Specific project
    claude-sandbox . --resume                       # Resume last conversation
    claude-sandbox . --resume abc123 --model opus   # Resume specific + model
    claude-sandbox --as /home/claude/workspace .    # Custom container path
    claude-sandbox . -- --verbose                   # Explicit passthrough

WHAT IT DOES
    Runs Claude Code with --dangerously-skip-permissions inside a container.
    Claude can build, test, and iterate autonomously without approval prompts.
    Only the project directory and ~/.claude are accessible to the container.

    Includes: Python 3.12, uv, ruff, mypy, pytest, gh, aws, Node.js 22

MOUNTS
    claude-home volume     -> /home/claude            (persistent home)
    ~/.claude              -> /home/claude/.claude    (auth, settings from host)
    ~/Screenshots          -> /home/claude/Screenshots (read-only)
    ~/.ssh                 -> /home/claude/.ssh       (read-only, if exists)
    ~/.aws                 -> /home/claude/.aws       (read-only, if exists)
    <project_path>         -> <container_workspace>

ENVIRONMENT
    Both .env files are loaded if present (global first, project overrides):
      1. ~/.claude/.env        (global, always loaded)
      2. <project_root>/.env   (project-specific, overrides global)
    Use this for GH_TOKEN, API keys, etc.

    CLAUDE_SANDBOX_SKIP_NETWORK    Skip the Docker network selection prompt

MORE INFO
    https://github.com/todd-working/claude-code-container
HELP
            exit 0
            ;;
        --as)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --as requires a path argument"
                exit 1
            fi
            if [[ "$2" != /* ]]; then
                echo "Error: --as path must be absolute (start with /)"
                exit 1
            fi
            as_path="$2"
            shift 2
            ;;
        --)
            shift
            claude_args+=("$@")
            break
            ;;
        -*)
            claude_args+=("$1")
            shift
            ;;
        *)
            if [[ "$project_path_set" == false && -d "$1" ]]; then
                project_path="$1"
                project_path_set=true
            else
                claude_args+=("$1")
            fi
            shift
            ;;
    esac
done

# Resolve to absolute path (handles "." -> "/full/path/to/dir")
project_path="$(cd "$project_path" && pwd)"
project_name="$(basename "$project_path")"

image="claude-sandbox"
docker_args=()

# Persist uv cache and installed Python tools across sessions
docker_args+=(-v claude-uv-cache:/home/claude/.cache/uv -v claude-python-bin:/home/claude/.local/bin)

# ============================================================
# CROSS-LINK SESSION HISTORY
# ============================================================
# Claude Code keys history on the absolute workspace path. Inside the container
# that path is /home/claude/workspaces/$project_name, on the host it's the real
# project path. Cross-link sessions so both sides see each other via /resume.

# Determine container workspace path (--as overrides default)
if [[ -n "$as_path" ]]; then
    container_workspace="$as_path"
else
    container_workspace="/home/claude/workspaces/$project_name"
fi

host_project_key="${project_path//\//-}"
container_project_key="${container_workspace//\//-}"
host_project_dir="$HOME/.claude/projects/$host_project_key"
container_project_dir="$HOME/.claude/projects/$container_project_key"

# Cross-link sessions between two project dirs (hard-links for JSONL, symlinks for dirs)
crosslink_sessions() {
    local src_dir="$1" dst_dir="$2" src_key="$3"

    [[ ! -d "$src_dir" ]] && return
    mkdir -p "$dst_dir"

    # Hard-link JSONL session files (Claude Code ignores symlinks when listing sessions)
    for f in "$src_dir"/*.jsonl(N); do
        [[ -L "$f" ]] && continue
        base="$(basename "$f")"
        [[ ! -e "$dst_dir/$base" ]] && ln "$f" "$dst_dir/$base"
    done

    # Symlink companion directories (subagent data; dirs can't be hard-linked)
    for d in "$src_dir"/*(N/); do
        [[ -L "$d" ]] && continue
        base="$(basename "$d")"
        [[ ! -e "$dst_dir/$base" ]] && ln -s "../$src_key/$base" "$dst_dir/$base"
    done
}

# Pre-launch: host -> container (so sandbox can /resume host conversations)
if [[ "$host_project_key" != "$container_project_key" ]]; then
    crosslink_sessions "$host_project_dir" "$container_project_dir" "$host_project_key"
    crosslink_sessions "$container_project_dir" "$host_project_dir" "$container_project_key"
    echo "History: cross-linked with $(basename "$host_project_dir")"
fi

# ============================================================
# PRE-FLIGHT CHECKS
# ============================================================

echo "Pre-flight checks..."

# Check ~/.claude exists
if [[ ! -d "$HOME/.claude" ]]; then
    echo "✗ ~/.claude not found."
    echo ""
    echo "  Run Claude Code outside the container first:"
    echo "    npx @anthropic-ai/claude-code"
    exit 1
fi

# Check image exists; auto-build from saved Dockerfile if available
if ! docker image inspect "$image" &>/dev/null; then
    saved_dockerfile="$HOME/.claude/sandbox/base.Dockerfile"
    if [[ -f "$saved_dockerfile" ]]; then
        echo "Image '$image' not found. Auto-building from saved Dockerfile..."
        docker build -t "$image" -f "$saved_dockerfile" . || {
            echo "✗ Auto-build failed. Run 'make build' from the claude-code-container repo."
            exit 1
        }
        echo "✓ Image rebuilt successfully"
    else
        echo "✗ Docker image '$image' not found."
        echo ""
        echo "  Build it first (from claude-code-container repo):"
        echo "    make build"
        exit 1
    fi
fi

# Show mount info
echo ""
echo "Mounts:"
echo "  ~/.claude → /home/claude/.claude"
echo "  ~/Screenshots → /home/claude/Screenshots (ro)"
[[ -d "$HOME/.ssh" ]] && echo "  ~/.ssh → /home/claude/.ssh (ro)"
[[ -d "$HOME/.aws" ]] && echo "  ~/.aws → /home/claude/.aws (ro)"
echo "  $project_path → $container_workspace"
echo ""
echo "Synced into volume:"
[[ -f "$HOME/.claude.json" ]] && echo "  ✓ ~/.claude.json (MCP servers)"
[[ -d "$HOME/.google_workspace_mcp" ]] && echo "  ✓ ~/.google_workspace_mcp/"
echo ""

# ============================================================
# NETWORK SELECTION (optional)
# ============================================================

if [[ -z "${CLAUDE_SANDBOX_SKIP_NETWORK:-}" ]]; then
    # Get custom networks (zsh array syntax)
    networks=("${(@f)$(docker network ls --format "{{.Name}}" | grep -vE "^(bridge|host|none)$" || true)}")
    if [[ ${#networks[@]} -gt 0 && -n "${networks[1]}" ]]; then
        echo "Available Docker networks:"
        echo "  0) None (default)"
        local i=1
        for net in "${networks[@]}"; do
            [[ -n "$net" ]] && echo "  $i) $net" && ((i++))
        done
        echo -n "Join a network? [0-$((i-1))]: "
        read -r choice
        if [[ "$choice" =~ ^[1-9][0-9]*$ ]] && [[ $choice -lt $i ]]; then
            local selected_network="${networks[$choice]}"
            docker_args+=(--network "$selected_network")
            echo "Joining network: $selected_network"
        fi
    fi
fi

# ============================================================
# RUN CONTAINER
# ============================================================

# Sync MCP servers and OAuth credentials into the claude-home volume.
# Uses `claude mcp add-json` so Claude Code manages its own config file.
echo "Syncing configs into container volume..."

# Extract mcpServers from host config, resolving ${VAR} placeholders from .env files
if [[ -f "$HOME/.claude.json" ]]; then
    mcp_servers=$(
        # Source .env files so env vars are available for placeholder resolution
        [[ -f "$HOME/.claude/.env" ]] && set -a && source "$HOME/.claude/.env" && set +a
        [[ -f "$project_path/.env" ]] && set -a && source "$project_path/.env" && set +a
        [[ -f "$HOME/.env" ]] && set -a && source "$HOME/.env" && set +a
        python3 -c "
import json, os, re, sys
with open('$HOME/.claude.json') as f:
    data = json.load(f)
def resolve(obj):
    if isinstance(obj, str):
        return re.sub(r'\\\$\{(\w+)\}', lambda m: os.environ.get(m.group(1), m.group(0)), obj)
    if isinstance(obj, dict):
        return {k: resolve(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [resolve(v) for v in obj]
    return obj
for name, config in data.get('mcpServers', {}).items():
    print(name)
    print(json.dumps(resolve(config)))
" 2>/dev/null)
fi

# Build the sync script to run inside the container
sync_script='#!/bin/sh
'

# Add each MCP server via claude mcp add-json
if [[ -n "$mcp_servers" ]]; then
    while IFS= read -r name && IFS= read -r config; do
        # Escape single quotes in config for shell embedding
        escaped_config="${config//\'/\'\\\'\'}"
        sync_script+="echo \"  Syncing MCP: $name\" >&2
claude mcp remove '$name' --scope user 2>/dev/null
claude mcp add-json '$name' '$escaped_config' --scope user || echo \"  ⚠ Failed to sync MCP server: $name\" >&2
"
    done <<< "$mcp_servers"
fi

# Sync global settings from host ~/.claude.json (remoteControlAtStartup, etc.)
if [[ -f "$HOME/.claude.json" ]]; then
    host_settings=$(python3 -c "
import json
with open('$HOME/.claude.json') as f:
    data = json.load(f)
# Keys to sync from host to container
for key in ['remoteControlAtStartup']:
    if key in data:
        print(f'{key}={json.dumps(data[key])}')
" 2>/dev/null)
    while IFS='=' read -r key value; do
        [[ -z "$key" ]] && continue
        sync_script+="
# Sync $key from host
if [ -f /home/claude/.claude.json ]; then
    python3 -c \"
import json
with open('/home/claude/.claude.json') as f: data = json.load(f)
data['$key'] = $value
with open('/home/claude/.claude.json', 'w') as f: json.dump(data, f, indent=2)
\" 2>/dev/null
fi
"
    done <<< "$host_settings"
fi

# Copy Google Workspace OAuth credentials
sync_script+='
if [ -d /tmp/host-google-workspace-mcp ]; then
    mkdir -p /home/claude/.google_workspace_mcp
    cp -r /tmp/host-google-workspace-mcp/* /home/claude/.google_workspace_mcp/
fi
'

# Run sync inside the container image (has claude CLI)
sync_args=()
[[ -d "$HOME/.google_workspace_mcp" ]] && sync_args+=(-v "$HOME/.google_workspace_mcp":/tmp/host-google-workspace-mcp:ro)

docker run --rm \
    --user "$(id -u):$(id -g)" \
    --entrypoint sh \
    -e HOME=/home/claude \
    -v claude-home:/home/claude \
    "${sync_args[@]}" \
    "$image" -c "$sync_script"

# Copy SSH keys/config into the container with correct ownership.
# Direct bind-mount fails because SSH demands strict permissions (600 for keys, 700 for dir)
# and the host UID may not match the container runtime UID. Copying into a temp dir with
# correct ownership solves both the permission and writable known_hosts problems.
ssh_staging=""
if [[ -d "$HOME/.ssh" ]]; then
    ssh_staging="$(mktemp -d)"
    cp -a "$HOME/.ssh/." "$ssh_staging/"
    chmod 700 "$ssh_staging"
    chmod 600 "$ssh_staging"/* 2>/dev/null || true
    docker_args+=(-v "$ssh_staging":/home/claude/.ssh)
fi

# Mount AWS config for profile/SSO-based auth (key-based auth works via .env)
if [[ -d "$HOME/.aws" ]]; then
    docker_args+=(-v "$HOME/.aws":/home/claude/.aws:ro)
fi

# Pass .env files: global first, then project-specific (project values override global)
if [[ -f "$HOME/.claude/.env" ]]; then
    docker_args+=(--env-file "$HOME/.claude/.env")
    echo "Environment: loaded ~/.claude/.env (global)"
fi
if [[ -f "$project_path/.env" ]]; then
    docker_args+=(--env-file "$project_path/.env")
    echo "Environment: loaded $project_path/.env (project)"
fi

# Fix settings.json macOS paths for the container.
resolved_dir="$(mktemp -d)"
cleanup() {
    rm -rf "$resolved_dir"
    [[ -n "$ssh_staging" ]] && rm -rf "$ssh_staging"
    # Post-exit: cross-link new sandbox sessions back to host
    if [[ "$host_project_key" != "$container_project_key" ]]; then
        crosslink_sessions "$container_project_dir" "$host_project_dir" "$container_project_key"
        crosslink_sessions "$host_project_dir" "$container_project_dir" "$host_project_key"
    fi
}
trap cleanup EXIT
settings_overlay=()

if [[ -f "$HOME/.claude/settings.json" ]]; then
    sed "s|/Users/[^/]*/\.claude/|/home/claude/.claude/|g" \
        "$HOME/.claude/settings.json" > "$resolved_dir/settings.json"
    if ! diff -q "$HOME/.claude/settings.json" "$resolved_dir/settings.json" &>/dev/null; then
        settings_overlay=(-v "$resolved_dir/settings.json:/home/claude/.claude/settings.json")
        echo "Fixed settings.json paths for container"
    fi
fi

# Sandbox environment instructions injected via --append-system-prompt
read -r -d '' sandbox_prompt <<'SANDBOX_PROMPT' || true
# Sandbox Environment
You are running inside a Docker container via claude-sandbox. All actions are auto-approved.

## Available tools
- Python 3.12, uv, ruff, mypy, pytest, ipython
- Node.js 22.x (LTS)
- CLI: git, gh, curl, jq, ripgrep, fd-find, aws, postgresql-client
- ML: wandb, huggingface-cli

## Package management
- Use uv for Python (not pip). Installed tools persist across sessions (uv tool install <pkg>).
- Use npm for Node.js packages.
- Use sudo apt-get install for system packages (no password required).

## Git
- Git uses HTTPS, not SSH. Auth is handled via GH_TOKEN.
- git push, git pull, and gh commands work out of the box.
- If git auth fails, check that GH_TOKEN is set in .env or ~/.claude/.env.

## SSH
- ~/.ssh is mounted read-only from the host (keys, config, known_hosts).
- SSH host aliases from ~/.ssh/config work directly (e.g. `ssh runpod`).
- Use ssh and scp for remote operations. See the runpod-fetch skill for guidelines.

## Filesystem
- Only the mounted project directory is writable.
- ~/.claude is shared with the host (settings, credentials, session history).
- /home/claude is a persistent volume — files outside the project and ~/.claude survive restarts.
SANDBOX_PROMPT

# Volume mount order matters:
# 1. claude-home volume provides persistent home directory (for .claude.json, etc.)
# 2. ~/.claude bind mount overlays credentials/settings from host
# 3. settings.json overlay fixes macOS paths for the container
# 4. workspace bind mount overlays the project directory

docker run -it --rm \
    --user "$(id -u):$(id -g)" \
    --name "claude-${project_name}-$$" \
    -e HOME=/home/claude \
    -e TERM=xterm-256color \
    "${docker_args[@]}" \
    -v claude-home:/home/claude \
    -v "$HOME/.claude":/home/claude/.claude \
    "${settings_overlay[@]}" \
    -v "$HOME/Screenshots":/home/claude/Screenshots:ro \
    -v "$project_path":"$container_workspace" \
    -w "$container_workspace" \
    "$image" claude --dangerously-skip-permissions --append-system-prompt "$sandbox_prompt" "${claude_args[@]}"
